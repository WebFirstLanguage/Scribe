// Scribe test suite.
//
// The engine is pulled in with `include from`, which exposes its actions to
// this file. Run from the repository root (so the fixture paths under build/
// resolve):
//
//     wfl --test tests/scribe.test.wfl
//
// or use the convenience script tests/run.sh.

include from "../src/scribe.wfl"

create map addr:
    "city" is "Paris"
end map
create map person:
    "name" is "Alice"
    "age" is 30
    "admin" is yes
    "addr" is addr
end map
store tag_list as ["wfl", "scribe", "twig"]
create map t_ctx:
    "user" is person
    "tags" is tag_list
    "title" is "Tom & Jerry <fun>"
    "num" is 7
    "blank" is ""
end map

define action called write_scribe_fixture with parameters fixture_path and fixture_content:
    open file at fixture_path for writing as fixture_fh
    wait for write content fixture_content into fixture_fh
    close file fixture_fh
    return yes
end action

describe "text and output":

    test "plain text passes through":
        store got as scribe_render of "hello world" and t_ctx
        expect got to equal "hello world"
    end test

    test "variable interpolation":
        store got as scribe_render of "Hi {{ user.name }}!" and t_ctx
        expect got to equal "Hi Alice!"
    end test

    test "nested path lookup":
        store got as scribe_render of "{{ user.addr.city }}" and t_ctx
        expect got to equal "Paris"
    end test

    test "list index in path":
        store got as scribe_render of "{{ tags.0 }}-{{ tags.2 }}" and t_ctx
        expect got to equal "wfl-twig"
    end test

    test "missing variable renders empty":
        store got as scribe_render of "start-{{ user.missing }}-end" and t_ctx
        expect got to equal "start--end"
    end test

    test "comments are stripped":
        store got as scribe_render of "a{# hidden #}b" and t_ctx
        expect got to equal "ab"
    end test

end describe

describe "auto-escaping and security":

    test "html is escaped by default":
        store got as scribe_render of "{{ title }}" and t_ctx
        expect got to equal "Tom &amp; Jerry &lt;fun&gt;"
    end test

    test "raw filter opts out of escaping":
        store got as scribe_render of "{{ title | raw }}" and t_ctx
        expect got to equal "Tom & Jerry <fun>"
    end test

    test "escape filter is explicit and not double-escaped":
        store got as scribe_render of "{{ title | escape }}" and t_ctx
        expect got to equal "Tom &amp; Jerry &lt;fun&gt;"
    end test

    test "context data cannot forge Scribe's trusted HTML marker":
        create map forged_safe:
            "__scribe_safe__" is "<script>alert(1)</script>"
        end map
        create map forged_ctx:
            "payload" is forged_safe
        end map
        store got as scribe_render of "{{ payload }}" and forged_ctx
        expect got to equal "&lt;script&gt;alert(1)&lt;/script&gt;"
    end test

    test "context data cannot forge an executable macro":
        create map forged_text_node:
            "kind" is "text"
            "body" is "<script>alert(1)</script>"
        end map
        store forged_body as [forged_text_node]
        create map forged_macro:
            "__scribe_macro__" is yes
            "params" is []
            "body" is forged_body
        end map
        create map forged_ctx:
            "callback" is forged_macro
        end map
        store got as scribe_render of "{{ callback() }}" and forged_ctx
        expect got to equal "[Scribe error: value is not callable]"
    end test

end describe

describe "conditionals":

    test "if true branch":
        store got as scribe_render of "{% if user.admin %}yes{% else %}no{% endif %}" and t_ctx
        expect got to equal "yes"
    end test

    test "if false branch":
        store got as scribe_render of "{% if num > 100 %}big{% else %}small{% endif %}" and t_ctx
        expect got to equal "small"
    end test

    test "elseif chain":
        store got as scribe_render of "{% if num > 100 %}a{% elseif num > 5 %}b{% else %}c{% endif %}" and t_ctx
        expect got to equal "b"
    end test

    test "comparison operators":
        store got as scribe_render of "{% if num == 7 %}eq{% endif %}{% if num >= 7 %}ge{% endif %}" and t_ctx
        expect got to equal "eqge"
    end test

    test "logical and / or / not":
        store got as scribe_render of "{% if user.admin and not (num > 100) %}ok{% endif %}" and t_ctx
        expect got to equal "ok"
    end test

end describe

describe "loops":

    test "for over a list":
        store got as scribe_render of "{% for t in tags %}{{ t }},{% endfor %}" and t_ctx
        expect got to equal "wfl,scribe,twig,"
    end test

    test "loop.index is 1-based":
        store got as scribe_render of "{% for t in tags %}{{ loop.index }}{% endfor %}" and t_ctx
        expect got to equal "123"
    end test

    test "loop.first and loop.last":
        store got as scribe_render of "{% for t in tags %}{% if loop.first %}<{% endif %}{{ t }}{% if loop.last %}>{% endif %}{% endfor %}" and t_ctx
        expect got to equal "<wflscribetwig>"
    end test

    test "for-else on empty collection":
        store got as scribe_render of "{% for x in missing %}X{% else %}none{% endfor %}" and t_ctx
        expect got to equal "none"
    end test

end describe

describe "set and expressions":

    test "set binds a variable":
        store got as scribe_render of "{% set g = 'Hi ' ~ user.name %}{{ g }}" and t_ctx
        expect got to equal "Hi Alice"
    end test

    test "arithmetic in output":
        store got as scribe_render of "{{ num * 3 + 1 }}" and t_ctx
        expect got to equal "22"
    end test

    test "string literal":
        store got as scribe_render of "{{ 'hello' }}" and t_ctx
        expect got to equal "hello"
    end test

end describe

describe "filters":

    test "upper and lower":
        store got as scribe_render of "{{ user.name | upper }}/{{ user.name | lower }}" and t_ctx
        expect got to equal "ALICE/alice"
    end test

    test "filter chain":
        store got as scribe_render of "{{ user.name | upper | lower }}" and t_ctx
        expect got to equal "alice"
    end test

    test "default on empty value":
        store got as scribe_render of "{{ blank | default('N/A') }}" and t_ctx
        expect got to equal "N/A"
    end test

    test "join a list":
        store got as scribe_render of "{{ tags | join(', ') }}" and t_ctx
        expect got to equal "wfl, scribe, twig"
    end test

    test "length of a list":
        store got as scribe_render of "{{ tags | length }}" and t_ctx
        expect got to equal "3"
    end test

    test "replace":
        store got as scribe_render of "{{ 'a-b-c' | replace('-', '+') }}" and t_ctx
        expect got to equal "a+b+c"
    end test

    test "first and last of a list":
        store got as scribe_render of "{{ tags | first }}/{{ tags | last }}" and t_ctx
        expect got to equal "wfl/twig"
    end test

    test "capitalize":
        store got as scribe_render of "{{ 'hello world' | capitalize }}" and t_ctx
        expect got to equal "Hello world"
    end test

end describe

describe "verbatim":

    test "verbatim emits its body literally":
        store got as scribe_render of "{% verbatim %}{{ user.name }} {% if x %}{% endif %}{% endverbatim %}" and t_ctx
        expect got to equal "{{ user.name }} {% if x %}{% endif %}"
    end test

end describe

describe "include and inheritance":

    test "include renders a partial with the current context":
        open file at "build/_scribe_partial.tmp" for writing as fh
        wait for write content "P:{{ user.name }}" into fh
        close file fh
        store got as scribe_render of "<{% include 'build/_scribe_partial.tmp' %}>" and t_ctx
        expect got to equal "<P:Alice>"
    end test

    test "include only preserves internal trust provenance":
        open file at "build/_scribe_safe_partial.tmp" for writing as sfh
        wait for write content "{{ payload }}" into sfh
        close file sfh
        create map forged_safe:
            "__scribe_safe__" is "<script>alert(1)</script>"
            "__scribe_nonce__" is nothing
        end map
        create map forged_ctx:
            "payload" is forged_safe
        end map
        store got as scribe_render of "{% include 'build/_scribe_safe_partial.tmp' with { payload: payload } only %}" and forged_ctx
        expect got to equal "&lt;script&gt;alert(1)&lt;/script&gt;"
    end test

    test "deep include chains stop at the render depth limit":
        store depth_i as 0
        repeat while depth_i is less than 55:
            store depth_path as "build/_scribe_depth_" with depth_i with ".tmp"
            store depth_content as "done"
            check if depth_i is less than 54:
                store next_i as depth_i plus 1
                change depth_content to "{% include 'build/_scribe_depth_" with next_i with ".tmp' %}"
            end check
            store wrote_fixture as write_scribe_fixture of depth_path and depth_content
            change depth_i to depth_i plus 1
        end repeat
        store got as scribe_render of "{% include 'build/_scribe_depth_0.tmp' %}" and t_ctx
        expect got to equal "[Scribe error: maximum template nesting exceeded]"
    end test

    test "extends overrides one block and keeps the default of another":
        open file at "build/_scribe_base.tmp" for writing as fb
        wait for write content "A{% block one %}D1{% endblock %}B{% block two %}D2{% endblock %}C" into fb
        close file fb
        store child as "{% extends 'build/_scribe_base.tmp' %}{% block two %}OVER{% endblock %}"
        store got as scribe_render of child and t_ctx
        expect got to equal "AD1BOVERC"
    end test

end describe

describe "multi-level inheritance":

    test "a base extends a grandparent across three levels":
        open file at "build/_sc_grand.tmp" for writing as fg
        wait for write content "<h>{% block head %}gh{% endblock %}</h><b>{% block body %}gb{% endblock %}</b>" into fg
        close file fg
        open file at "build/_sc_mid.tmp" for writing as fm
        wait for write content "{% extends 'build/_sc_grand.tmp' %}{% block body %}<m>{% block content %}mc{% endblock %}</m>{% endblock %}" into fm
        close file fm
        store child as "{% extends 'build/_sc_mid.tmp' %}{% block content %}CC{% endblock %}"
        store got as scribe_render of child and t_ctx
        expect got to equal "<h>gh</h><b><m>CC</m></b>"
    end test

    test "the most-derived override wins over an intermediate one":
        open file at "build/_sc_g2.tmp" for writing as fg2
        wait for write content "{% block t %}base{% endblock %}" into fg2
        close file fg2
        open file at "build/_sc_m2.tmp" for writing as fm2
        wait for write content "{% extends 'build/_sc_g2.tmp' %}{% block t %}mid{% endblock %}" into fm2
        close file fm2
        store child as "{% extends 'build/_sc_m2.tmp' %}{% block t %}leaf{% endblock %}"
        store got as scribe_render of child and t_ctx
        expect got to equal "leaf"
    end test

end describe

describe "macros":

    test "define and call a macro, calling before its definition":
        store t as "{{ hi('Sam') }}{% macro hi(n) %}Hi {{ n }}!{% endmacro %}"
        store got as scribe_render of t and t_ctx
        expect got to equal "Hi Sam!"
    end test

    test "macro output is trusted but its interpolations are escaped":
        store t as "{% macro tag(v) %}<i>{{ v }}</i>{% endmacro %}{{ tag('a & b') }}"
        store got as scribe_render of t and t_ctx
        expect got to equal "<i>a &amp; b</i>"
    end test

    test "a macro with a missing argument binds it to nothing":
        store t as "{% macro pair(a, b) %}{{ a }}-{{ b }}{% endmacro %}{{ pair('x') }}"
        store got as scribe_render of t and t_ctx
        expect got to equal "x-"
    end test

    test "import a macro namespace from a file":
        open file at "build/_sc_forms.tmp" for writing as ff
        wait for write content "{% macro field(n) %}<input name=\"{{ n }}\">{% endmacro %}" into ff
        close file ff
        store t as "{% import 'build/_sc_forms.tmp' as forms %}{{ forms.field('email') }}"
        store got as scribe_render of t and t_ctx
        expect got to equal "<input name=\"email\">"
    end test

    test "from import binds a macro by name":
        open file at "build/_sc_forms2.tmp" for writing as ff2
        wait for write content "{% macro field(n) %}[{{ n }}]{% endmacro %}" into ff2
        close file ff2
        store t as "{% from 'build/_sc_forms2.tmp' import field %}{{ field('x') }}"
        store got as scribe_render of t and t_ctx
        expect got to equal "[x]"
    end test

    test "a call with a missing closing paren fails gracefully, not fatally":
        store t as "{% macro hi(n) %}Hi {{ n }}{% endmacro %}{{ hi('a' }}"
        store got as scribe_render of t and t_ctx
        expect got to equal "Hi a"
    end test

    test "an imported macro can call a sibling in its home file":
        open file at "build/_sc_lib.tmp" for writing as fl
        wait for write content "{% macro wrap(x) %}[{{ x }}]{% endmacro %}{% macro shout(x) %}{{ wrap(x) | upper }}{% endmacro %}" into fl
        close file fl
        store t as "{% from 'build/_sc_lib.tmp' import shout %}{{ shout('hi') }}"
        store got as scribe_render of t and t_ctx
        expect got to equal "[HI]"
    end test

    test "recursive macros stop at the render depth limit":
        store t as "{% macro recurse(n) %}{% if n > 0 %}{{ recurse(n - 1) }}{% else %}done{% endif %}{% endmacro %}{{ recurse(55) }}"
        store got as scribe_render of t and t_ctx
        expect got to equal "[Scribe error: maximum template nesting exceeded]"
    end test

end describe

describe "scoped includes":

    test "include with an explicit scoped context":
        open file at "build/_sc_badge.tmp" for writing as fbg
        wait for write content "<b class=\"{{ cls }}\">{{ label }}</b>" into fbg
        close file fbg
        store got as scribe_render of "{% include 'build/_sc_badge.tmp' with { cls: 'hot', label: 'NEW' } %}" and t_ctx
        expect got to equal "<b class=\"hot\">NEW</b>"
    end test

    test "include with only isolates the partial from the caller context":
        open file at "build/_sc_badge2.tmp" for writing as fbg2
        wait for write content "[{{ user.name }}|{{ label }}]" into fbg2
        close file fbg2
        store got as scribe_render of "{% include 'build/_sc_badge2.tmp' with { label: 'L' } only %}" and t_ctx
        expect got to equal "[|L]"
    end test

end describe

describe "new filters":

    test "truncate with the default suffix":
        store got as scribe_render of "{{ 'The quick brown fox' | truncate(9) }}" and t_ctx
        expect got to equal "The quick..."
    end test

    test "truncate with a custom suffix and short-string passthrough":
        store got as scribe_render of "{{ 'hi' | truncate(9, '') }}/{{ 'abcdefghij' | truncate(5, '!') }}" and t_ctx
        expect got to equal "hi/abcde!"
    end test

    test "striptags removes html markup":
        store got as scribe_render of "{{ '<b>bold</b> text' | striptags }}" and t_ctx
        expect got to equal "bold text"
    end test

    test "striptags keeps an unmatched < as literal text":
        store got as scribe_render of "{{ '5 < 10 apples' | striptags }}" and t_ctx
        expect got to equal "5 &lt; 10 apples"
    end test

    test "asset builds a root-relative path":
        store got as scribe_render of "{{ 'css/app.css' | asset }}" and t_ctx
        expect got to equal "/css/app.css"
    end test

    test "asset joins a base url without doubling the slash":
        store got as scribe_render of "{{ '/js/app.js' | asset('https://cdn.example.com/') }}" and t_ctx
        expect got to equal "https://cdn.example.com/js/app.js"
    end test

    test "url builds a root-relative route":
        store got as scribe_render of "{{ 'about' | url }}" and t_ctx
        expect got to equal "/about"
    end test

    test "date formats a date value with a strftime pattern":
        store d as parse_date of "2026-07-10" and "%Y-%m-%d"
        create map dctx:
            "d" is d
        end map
        store got as scribe_render of "{{ d | date('%d/%m/%Y') }}" and dctx
        expect got to equal "10/07/2026"
    end test

    test "markdown renders headings, emphasis, and paragraphs":
        store got as scribe_render of "{{ '# Hi\n\nA **bold** move.' | markdown }}" and t_ctx
        expect got to equal "<h1>Hi</h1><p>A <strong>bold</strong> move.</p>"
    end test

    test "markdown escapes raw html before formatting":
        store got as scribe_render of "{{ '<script>x</script>' | markdown }}" and t_ctx
        expect got to equal "<p>&lt;script&gt;x&lt;/script&gt;</p>"
    end test

    test "markdown neutralises a javascript: link url":
        store got as scribe_render of "{{ '[x](javascript:evil)' | markdown }}" and t_ctx
        expect got to equal "<p><a href=\"#\">x</a></p>"
    end test

    test "markdown neutralises a dangerous scheme behind a leading C0 control":
        store dangerous_url as parse_json of "\"\\u000cjavascript:evil\""
        create map link_ctx:
            "url" is dangerous_url
        end map
        store got as scribe_render of "{{ ('[x](' ~ url ~ ')') | markdown }}" and link_ctx
        expect got to equal "<p><a href=\"#\">x</a></p>"
    end test

    test "markdown does not pair delimiters across separate code spans":
        store got as scribe_render of "{{ 'run `a**b` and `c**d`' | markdown }}" and t_ctx
        expect got to equal "<p>run <code>a**b</code> and <code>c**d</code></p>"
    end test

end describe

describe "empty-collection rendering":

    test "an empty list renders as empty text, not [ ]":
        store empty_list as []
        create map ectx:
            "items" is empty_list
        end map
        store got as scribe_render of "before-{{ items }}-after" and ectx
        expect got to equal "before--after"
    end test

end describe

describe "markdown blockquotes":

    test "a quoted line becomes a blockquote":
        store got as scribe_render of "{{ '> quoted' | markdown }}" and t_ctx
        expect got to equal "<blockquote><p>quoted</p></blockquote>"
    end test

    test "consecutive quoted lines join into one blockquote paragraph":
        store got as scribe_render of "{{ '> a\n> b' | markdown }}" and t_ctx
        expect got to equal "<blockquote><p>a b</p></blockquote>"
    end test

    test "a blank line closes the blockquote":
        store got as scribe_render of "{{ '> q\n\nafter' | markdown }}" and t_ctx
        expect got to equal "<blockquote><p>q</p></blockquote><p>after</p>"
    end test

    test "inline markdown is applied inside a blockquote":
        store got as scribe_render of "{{ '> a **bold** word' | markdown }}" and t_ctx
        expect got to equal "<blockquote><p>a <strong>bold</strong> word</p></blockquote>"
    end test

    test "html inside a blockquote is still escaped":
        store got as scribe_render of "{{ '> <script>x</script>' | markdown }}" and t_ctx
        expect got to equal "<blockquote><p>&lt;script&gt;x&lt;/script&gt;</p></blockquote>"
    end test

    test "blockquotes nest":
        store got as scribe_render of "{{ '> > deep' | markdown }}" and t_ctx
        expect got to equal "<blockquote><blockquote><p>deep</p></blockquote></blockquote>"
    end test

    test "pathological nesting actually hits the depth cap":
        // 40 levels of `> `, past the cap of 32. Once the cap engages the rest
        // is emitted as escaped plain text, so the output must still contain an
        // escaped `>` — the marker that recursion stopped early. Asserting only
        // that "text" survives is not enough: an unbounded renderer produces
        // that too, it just recurses 40 deep to do it.
        store deep as "text"
        store i as 0
        repeat while i is less than 40:
            change deep to "> " with deep
            change i to i plus 1
        end repeat
        create map deep_ctx:
            "src" is deep
        end map
        store got as scribe_render of "{{ src | markdown }}" and deep_ctx
        expect got to contain "&gt;"
    end test

    test "a quote left open at end of input is still capped":
        // The whole quote sits on one line, so it is buffered and only closed at
        // end of input. That close path must stay inside the same depth budget —
        // if it restarts at depth 0 the cap never engages and recursion tracks
        // the input's nesting level, exhausting the call stack.
        store deep as "text"
        store i as 0
        repeat while i is less than 1200:
            change deep to "> " with deep
            change i to i plus 1
        end repeat
        create map deep_ctx:
            "src" is deep
        end map
        store got as scribe_render of "{{ src | markdown }}" and deep_ctx
        expect got to contain "&gt;"
    end test

end describe

describe "markdown fenced code blocks":

    test "a fence renders a pre/code block":
        store got as scribe_render of "{{ '```\nplain\n```' | markdown }}" and t_ctx
        expect got to equal "<pre><code>plain</code></pre>"
    end test

    test "code block contents are escaped, not interpreted as html":
        store got as scribe_render of "{{ '```\na < b & <i>c</i>\n```' | markdown }}" and t_ctx
        expect got to equal "<pre><code>a &lt; b &amp; &lt;i&gt;c&lt;/i&gt;</code></pre>"
    end test

    test "markdown syntax inside a fence stays literal":
        store got as scribe_render of "{{ '```\n# not a heading\n**not bold**\n```' | markdown }}" and t_ctx
        expect got to equal "<pre><code># not a heading\n**not bold**</code></pre>"
    end test

    test "an info string on the opening fence is not emitted":
        store got as scribe_render of "{{ '```rust\nlet x = 1;\n```' | markdown }}" and t_ctx
        expect got to equal "<pre><code>let x = 1;</code></pre>"
    end test

    test "an unterminated fence still closes its code block":
        store got as scribe_render of "{{ '```\ndangling' | markdown }}" and t_ctx
        expect got to equal "<pre><code>dangling</code></pre>"
    end test

    test "a fence flushes an open paragraph first":
        store got as scribe_render of "{{ 'intro\n```\ncode\n```' | markdown }}" and t_ctx
        expect got to equal "<p>intro</p><pre><code>code</code></pre>"
    end test

end describe

describe "filters preserve the safe marker":

    // A filter that only subsets, trims, or strips already-trusted text must
    // hand back trusted text. Dropping the marker makes the final interpolation
    // escape the already-escaped entities a second time (`&#39;` -> `&amp;#39;`).

    test "striptags keeps trusted output trusted":
        store got as scribe_render of "{{ 'a > b' | markdown | striptags }}" and t_ctx
        expect got to equal "a &gt; b"
    end test

    test "trim keeps trusted output trusted":
        store got as scribe_render of "{{ '  <b>hi</b>  ' | raw | trim }}" and t_ctx
        expect got to equal "<b>hi</b>"
    end test

    test "first keeps trusted output trusted":
        store got as scribe_render of "{{ '<b>' | raw | first }}" and t_ctx
        expect got to equal "<"
    end test

    test "last keeps trusted output trusted":
        store got as scribe_render of "{{ '<b>' | raw | last }}" and t_ctx
        expect got to equal ">"
    end test

    test "truncate keeps trusted output trusted and does not double-escape":
        store got as scribe_render of "{{ \"it's a test\" | markdown | striptags | truncate(11) }}" and t_ctx
        expect got to equal "it&#39;s a ..."
    end test

    test "truncate escapes a caller-supplied suffix on the trusted path":
        // The trusted result skips output escaping, so an attacker-influenced
        // suffix would otherwise be a raw-HTML injection point.
        store got as scribe_render of "{{ 'abcdef' | raw | truncate(2, '<img src=x onerror=1>') }}" and t_ctx
        expect got to equal "ab&lt;img src=x onerror=1&gt;"
    end test

    test "an untrusted value is still escaped after truncate":
        store got as scribe_render of "{{ '<b>abcdef' | truncate(4, '') }}" and t_ctx
        expect got to equal "&lt;b&gt;a"
    end test

end describe

describe "striptags across block elements":

    // Removing a tag has to leave a word boundary behind. Deleting it outright
    // welds the surrounding words together ("one.Two"), which is exactly what an
    // excerpt built as `body | markdown | striptags | truncate(n)` looks like.

    test "adjacent block elements do not weld their text together":
        store got as scribe_render of "{{ '<p>One.</p><p>Two.</p>' | raw | striptags }}" and t_ctx
        expect got to equal "One. Two."
    end test

    test "list items stay separated":
        store got as scribe_render of "{{ '<ul><li>one</li><li>two</li></ul>' | raw | striptags }}" and t_ctx
        expect got to equal "one two"
    end test

    test "inline tags inside a word do not introduce a space":
        store got as scribe_render of "{{ 'un<b>frigging</b>believable' | raw | striptags }}" and t_ctx
        expect got to equal "un frigging believable"
    end test

    test "runs of whitespace collapse to one space":
        store got as scribe_render of "{{ '<p>a</p>   \n  <p>b</p>' | raw | striptags }}" and t_ctx
        expect got to equal "a b"
    end test

    test "leading and trailing whitespace is trimmed":
        store got as scribe_render of "{{ '  <p>only</p>  ' | raw | striptags }}" and t_ctx
        expect got to equal "only"
    end test

    test "a rendered markdown post reads as prose":
        store md as "Intro line.\n\n> a quoted claim\n\n- one\n- two"
        create map mctx:
            "body" is md
        end map
        store got as scribe_render of "{{ body | markdown | striptags }}" and mctx
        expect got to equal "Intro line. a quoted claim one two"
    end test

end describe
